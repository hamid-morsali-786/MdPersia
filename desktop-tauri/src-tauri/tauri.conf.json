{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdPersia",
  "version": "0.3.0-beta.3",
  "identifier": "com.famddf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MdPersia | تبدیل تخصصی مارک‌داون فارسی به PDF و Word",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../src/fa_md_pdf/assets/mdpersia.ico",
      "../../src/fa_md_pdf/assets/mdpersia.png"
    ],
    "targets": [
      "nsis"
    ],
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../output/release/staging/assets/": "assets/",
      "../../output/release/staging/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../../output/release/staging/release-manifest.json": "release-manifest.json",
      "../../output/release/staging/reader/": "reader/",
      "../../output/release/staging/conversion-catalog.json": "conversion-catalog.json"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "minimumWebview2Version": "120.0.2210.61",
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": [
          "English"
        ],
        "installerHooks": "installer/hooks.nsh",
        "startMenuFolder": "MdPersia"
      }
    }
  }
}
